{
  "contractVersion": "1.0.0",
  "id": "frame-robot-deployment",
  "kind": "narrow",
  "trigger": "Use when framing an AMR deployment problem, desired outcome, scope, stakeholders or unmet needs before specifying material flow.",
  "requiredInputs": [
    "User-selected project folder and current source snapshot",
    "Caller-supplied problem, outcome, scope and stakeholder facts",
    "Bundled patch and deployment schemas matching the installed CLI",
    "Existing project authority or exact scopes explicitly supplied by the caller"
  ],
  "specRange": "^1.0.0",
  "cliRange": ">=1.0.0-rc.1 <2.0.0",
  "patchRange": "^1.0.0",
  "fieldsRead": ["*"],
  "fieldsWritten": [
    "project.*",
    "stakeholders.*",
    "needs.*",
    "problems.*",
    "challenges.*",
    "challengeAnswers.*"
  ],
  "dependencies": [],
  "commands": [
    {
      "command": "capabilities",
      "args": ["--json", "--offline"]
    },
    {
      "command": "show",
      "args": ["--project", "${project}", "--json", "--offline"]
    },
    {
      "command": "patch check",
      "args": ["patch.json", "--project", "${project}", "--json", "--offline"]
    },
    {
      "command": "patch diff",
      "args": ["patch.json", "--project", "${project}", "--json", "--offline"]
    },
    {
      "command": "patch apply",
      "args": ["patch.json", "--project", "${project}", "--json", "--offline"]
    },
    {
      "command": "validate",
      "args": ["--project", "${project}", "--json", "--offline"]
    }
  ],
  "validation": [
    "schema",
    "capability-fields",
    "source-identity",
    "references",
    "permissions",
    "readiness-report"
  ],
  "stopConditions": [
    "unsupported",
    "missing-authority",
    "stale-base",
    "invalid-input",
    "missing-facts",
    "indeterminate-receipt"
  ],
  "authority": {
    "grantsPermissions": false,
    "actorKind": "agent",
    "capabilityIdRequired": true,
    "protectedDecisions": "separate-supplied-workflow"
  },
  "output": {
    "formatVersion": "1.0.0",
    "required": [
      "status",
      "capabilityId",
      "changeId",
      "baseRevision",
      "baseHash",
      "sourceRevision",
      "sourceHash",
      "receiptDigest",
      "proposalId",
      "patchDigest",
      "diff",
      "readiness",
      "findings",
      "questions",
      "nextAction"
    ],
    "statuses": ["unchanged", "checked", "proposed", "applied", "conflict", "blocked"]
  }
}
