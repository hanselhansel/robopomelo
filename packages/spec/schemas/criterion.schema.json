{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robopomelo.dev/schemas/criterion.schema.json",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {"const": "numeric"},
        "operator": {"enum": ["gte","lte","eq","between"]},
        "threshold": {"$ref": "common.schema.json#/$defs/quantity"},
        "upper": {"$ref": "common.schema.json#/$defs/quantity"}
      },
      "required": ["kind","operator","threshold"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {"kind": {"const": "boolean"},"expected": {"type": "boolean"}},
      "required": ["kind","expected"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {"kind": {"const": "categorical"},"expected": {"type": "array","items": {"type": "string"}}},
      "required": ["kind","expected"],
      "additionalProperties": false
    }
  ]
}
