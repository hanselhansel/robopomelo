{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robopomelo.dev/schemas/decision.schema.json",
  "type": "object",
  "properties": {
    "id": {"$ref": "common.schema.json#/$defs/id"},
    "title": {"type": "string"},
    "description": {"$ref": "knowledge-text.schema.json"},
    "ownerId": {"$ref": "knowledge-id.schema.json"},
    "sourceEvidenceIds": {"type": "array","items": {"$ref": "common.schema.json#/$defs/id"}},
    "extensions": {"$ref": "common.schema.json#/$defs/extensions"},
    "question": {"$ref": "knowledge-text.schema.json"},
    "options": {"type": "array","items": {"type": "string"}},
    "rationale": {"$ref": "knowledge-text.schema.json"},
    "state": {"enum": ["proposed","accepted"]},
    "relatedIds": {"type": "array","items": {"$ref": "common.schema.json#/$defs/id"}},
    "actor": {"anyOf": [{"type": "null"},{"$ref": "common.schema.json#/$defs/actor"}]},
    "decidedAt": {"anyOf": [{"type": "null"},{"$ref": "common.schema.json#/$defs/datetime"}]},
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"$ref": "common.schema.json#/$defs/id"},
          "claimPath": {"enum": ["title","description","question","options","rationale"]},
          "required": {"type": "boolean"},
          "evidenceIds": {"type": "array","items": {"$ref": "common.schema.json#/$defs/id"}},
          "attestation": {"anyOf": [{"type": "null"},{"$ref": "attestation.schema.json"}]}
        },
        "required": ["id","claimPath","required","evidenceIds","attestation"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "title",
    "description",
    "ownerId",
    "sourceEvidenceIds",
    "extensions",
    "question",
    "options",
    "rationale",
    "state",
    "relatedIds",
    "actor",
    "decidedAt"
  ],
  "additionalProperties": false
}
