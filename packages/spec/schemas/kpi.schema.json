{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/hanselhansel/robopomelo/v1.0.0/packages/spec/schemas/kpi.schema.json",
  "type": "object",
  "properties": {
    "id": {"$ref": "common.schema.json#/$defs/id"},
    "title": {"type": "string"},
    "description": {"$ref": "knowledge-text.schema.json"},
    "ownerId": {"$ref": "knowledge-id.schema.json"},
    "sourceEvidenceIds": {"type": "array","items": {"$ref": "common.schema.json#/$defs/id"}},
    "extensions": {"$ref": "common.schema.json#/$defs/extensions"},
    "definition": {"$ref": "knowledge-text.schema.json"},
    "baseline": {"$ref": "knowledge-quantity.schema.json"},
    "target": {"$ref": "knowledge-quantity.schema.json"},
    "measurementMethod": {"$ref": "knowledge-text.schema.json"},
    "measurementWindow": {"$ref": "knowledge-text.schema.json"},
    "needIds": {"type": "array","items": {"$ref": "common.schema.json#/$defs/id"}},
    "workflowIds": {"type": "array","items": {"$ref": "common.schema.json#/$defs/id"}},
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"$ref": "common.schema.json#/$defs/id"},
          "claimPath": {"enum": ["title","description","definition","baseline","target","measurementMethod","measurementWindow"]},
          "required": {"type": "boolean"},
          "evidenceIds": {"type": "array","items": {"$ref": "common.schema.json#/$defs/id"}},
          "attestation": {"anyOf": [{"type": "null"},{"$ref": "attestation.schema.json"}]}
        },
        "required": ["id","claimPath","required","evidenceIds","attestation"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "title",
    "description",
    "ownerId",
    "sourceEvidenceIds",
    "extensions",
    "definition",
    "baseline",
    "target",
    "measurementMethod",
    "measurementWindow",
    "needIds",
    "workflowIds"
  ],
  "additionalProperties": false
}
