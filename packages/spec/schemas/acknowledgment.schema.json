{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/hanselhansel/robopomelo/v1.0.0/packages/spec/schemas/acknowledgment.schema.json",
  "type": "object",
  "properties": {
    "id": {"$ref": "common.schema.json#/$defs/id"},
    "findingFingerprint": {"$ref": "common.schema.json#/$defs/hash"},
    "planningHash": {"$ref": "common.schema.json#/$defs/hash"},
    "actor": {"$ref": "common.schema.json#/$defs/actor"},
    "reason": {"type": "string"},
    "recordedAt": {"$ref": "common.schema.json#/$defs/datetime"},
    "source": {"type": "string"}
  },
  "required": ["id","findingFingerprint","planningHash","actor","reason","recordedAt","source"],
  "additionalProperties": false
}
