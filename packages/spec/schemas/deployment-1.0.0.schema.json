{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/hanselhansel/robopomelo/v1.0.0/packages/spec/schemas/deployment-1.0.0.schema.json",
  "type": "object",
  "properties": {
    "specVersion": {"const": "1.0.0"},
    "project": {"$ref": "project.schema.json"},
    "meta": {"$ref": "revision.schema.json"},
    "stakeholders": {"type": "array","items": {"$ref": "stakeholder.schema.json"}},
    "needs": {"type": "array","items": {"$ref": "need.schema.json"}},
    "problems": {"type": "array","items": {"$ref": "problem.schema.json"}},
    "workflows": {"type": "array","items": {"$ref": "workflow.schema.json"}},
    "challenges": {"type": "array","items": {"$ref": "open-issue.schema.json"}},
    "risks": {"type": "array","items": {"$ref": "risk.schema.json"}},
    "assumptions": {"type": "array","items": {"$ref": "assumption.schema.json"}},
    "kpis": {"type": "array","items": {"$ref": "kpi.schema.json"}},
    "requirements": {"type": "array","items": {"$ref": "requirement.schema.json"}},
    "acceptanceTests": {"type": "array","items": {"$ref": "acceptance-test.schema.json"}},
    "evidence": {"type": "array","items": {"$ref": "evidence.schema.json"}},
    "decisions": {"type": "array","items": {"$ref": "decision.schema.json"}},
    "challengeAnswers": {"type": "array","items": {"$ref": "challenge-answer.schema.json"}},
    "review": {"$ref": "review-state.schema.json"},
    "extensions": {"$ref": "common.schema.json#/$defs/extensions"}
  },
  "required": [
    "specVersion",
    "project",
    "meta",
    "stakeholders",
    "needs",
    "problems",
    "workflows",
    "challenges",
    "risks",
    "assumptions",
    "kpis",
    "requirements",
    "acceptanceTests",
    "evidence",
    "decisions",
    "challengeAnswers",
    "review",
    "extensions"
  ],
  "additionalProperties": false
}
