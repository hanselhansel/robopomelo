{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/hanselhansel/robopomelo/v1.0.0/packages/spec/schemas/revision.schema.json",
  "type": "object",
  "properties": {
    "revisionId": {"$ref": "common.schema.json#/$defs/id"},
    "parentRevisionId": {"anyOf": [{"type": "null"},{"$ref": "common.schema.json#/$defs/id"}]},
    "createdAt": {"$ref": "common.schema.json#/$defs/datetime"},
    "updatedAt": {"$ref": "common.schema.json#/$defs/datetime"}
  },
  "required": ["revisionId","parentRevisionId","createdAt","updatedAt"],
  "additionalProperties": false
}
